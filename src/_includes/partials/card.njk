<article class="card" data-theme="{{ post.data.theme }}">
  {%- if post.data.image %}
  <a class="card-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.image }}" alt="" loading="lazy">
  </a>
  {%- endif %}
  <div class="card-body">
    <p class="meta">
      <a class="chip chip-theme" data-theme="{{ post.data.theme }}" href="/categories/?theme={{ post.data.theme | urlencode }}">{{ post.data.theme }}</a>
      <time datetime="{{ post.date | dateIso }}">{{ post.date | dateFr }}</time>
    </p>
    <h2 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="card-summary">{{ post.data.summary or (post.templateContent | excerpt(220)) }}</p>
    <span class="read-more" aria-hidden="true">Lire l'article</span>
  </div>
</article>
